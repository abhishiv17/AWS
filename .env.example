# ==============================================================================
# CampusEvac - Environment Template
# Bharat Builds Tour (AWS Builder Center x WeMakeDevs)
# ==============================================================================

# ------------------------------------------------------------------------------
# Network provider
# ------------------------------------------------------------------------------
NEXT_PUBLIC_NETWORK_MODE=mock
NEXT_PUBLIC_APPSYNC_URL=
NEXT_PUBLIC_APPSYNC_EVENTS_URL=

# ------------------------------------------------------------------------------
# AWS target configuration
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Use IAM roles, AWS SSO, or deployment-provided credentials. Never put long-lived
# AWS access keys in this file or expose them to the browser.

# Amazon Bedrock (Dynamic Emergency Scenario & Incident Generator)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Amazon Polly (Emergency Broadcast System & Warden Radio Comms)
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=neural

# Amazon DynamoDB (Drill Events & After-Action Reports)
DYNAMODB_DRILL_TABLE=campusevac-drill-telemetry
