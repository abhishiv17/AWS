# CampusEvac - copy to .env.local (git-ignored) and never commit real values.
# Fill it with `npm run env:pull` (AWS CLI signed in to the account that has CampusEvacStack),
# or copy HttpHost, RealtimeEndpoint and ApiKey from CloudFormation > CampusEvacStack > Outputs.
NEXT_PUBLIC_EVENTS_HTTP_HOST=
NEXT_PUBLIC_EVENTS_REALTIME_URL=
NEXT_PUBLIC_EVENTS_API_KEY=
